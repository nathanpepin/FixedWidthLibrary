<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <RootNamespace>FixedWidthLibrary</RootNamespace>
        <PackageId>FixedWidthLibrary</PackageId>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <Authors>Nathan Pepin</Authors>
        <Company>Nathan Pepin</Company>
        <Product>FixedWidthLibrary</Product>
        <Title>FixedWidthLibrary - Source generator and analyzer</Title>
        <Description>Roslyn analyzer and source generator for building fixed-width record readers/writers from attributes. Use with FixedWidthLibrary.Core.</Description>
        <PackageVersion>0.1.0</PackageVersion>
        <PackageProjectUrl>https://github.com/nathanpepin/FixedWidthLibrary</PackageProjectUrl>
        <RepositoryUrl>https://github.com/nathanpepin/FixedWidthLibrary</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>fixed-width;fixed width;analyzer;roslyn;source generator;code generation;serialization</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true"
              PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
